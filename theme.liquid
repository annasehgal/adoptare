<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Adoptare — Every Origin Matters</title>
<meta name="description" content="Adoptare is a nonprofit streetwear brand empowering adoptees and foster youth through clothing initiatives and scholarships. Every origin matters."/>
<meta property="og:title" content="Adoptare — Every Origin Matters"/>
<meta property="og:description" content="Empowering adoptees and foster youth through clothing and scholarships. Shop Drop 001 now."/>
<meta property="og:url" content="https://adoptare.store"/>
<meta name="twitter:card" content="summary_large_image"/>
<link rel="canonical" href="https://adoptare.store"/>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-867Y091BZV"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-867Y091BZV');
</script>
<style>
  *{margin:0;padding:0;box-sizing:border-box;}
  :root{--black:#0a0a0a;--white:#f5f5f0;--accent:#e8d5b0;--muted:#c8c8c0;--card-bg:#141414;--border:#2a2a2a;}
  body{background:var(--black);color:var(--white);font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;overflow-x:hidden;scroll-behavior:smooth;}
  a{color:inherit;text-decoration:none;}

  /* COOKIE BANNER */
  .cookie-banner{position:fixed;bottom:0;left:0;right:0;background:#111;border-top:1px solid var(--border);padding:1rem 2.5rem;display:flex;justify-content:space-between;align-items:center;z-index:300;gap:2rem;}
  .cookie-banner.hidden{display:none;}
  .cookie-text{font-size:0.72rem;color:var(--muted);line-height:1.6;max-width:600px;}
  .cookie-text a{color:var(--accent);text-decoration:underline;}
  .cookie-btns{display:flex;gap:0.75rem;flex-shrink:0;}
  .cookie-accept{background:var(--white);color:var(--black);border:none;padding:0.5rem 1.25rem;font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;font-weight:700;cursor:pointer;}
  .cookie-accept:hover{background:var(--accent);}
  .cookie-decline{background:none;color:var(--muted);border:1px solid var(--border);padding:0.5rem 1.25rem;font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;cursor:pointer;}

  /* BACK TO TOP */
  .back-to-top{position:fixed;bottom:5rem;right:2rem;background:var(--white);color:var(--black);border:none;width:40px;height:40px;display:flex;align-items:center;justify-content:center;font-size:1rem;cursor:pointer;z-index:99;opacity:0;transition:opacity 0.3s;font-weight:700;}
  .back-to-top.visible{opacity:1;}
  .back-to-top:hover{background:var(--accent);}

  /* CONTACT POPUP */
  .contact-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.85);z-index:500;align-items:center;justify-content:center;}
  .contact-overlay.active{display:flex;}
  .contact-popup{background:#111;border:1px solid var(--border);max-width:460px;width:90%;padding:2.5rem;position:relative;max-height:90vh;overflow-y:auto;}
  .contact-popup::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--accent);}
  .contact-close{position:absolute;top:1rem;right:1rem;background:none;border:none;color:var(--muted);font-size:1.2rem;cursor:pointer;}
  .contact-tag{font-size:0.6rem;letter-spacing:0.25em;text-transform:uppercase;color:var(--accent);margin-bottom:1rem;}
  .contact-title{font-size:1.8rem;font-weight:800;text-transform:uppercase;line-height:0.9;margin-bottom:0.5rem;}
  .contact-email-label{font-size:0.72rem;letter-spacing:0.1em;color:var(--muted);margin-bottom:1.5rem;}
  .contact-email-label span{color:var(--accent);}
  .contact-input{width:100%;background:#0a0a0a;border:1px solid var(--border);color:var(--white);padding:0.85rem 1rem;font-size:0.85rem;font-family:inherit;outline:none;margin-bottom:0.75rem;}
  .contact-input::placeholder{color:#555;}
  .contact-textarea{width:100%;background:#0a0a0a;border:1px solid var(--border);color:var(--white);padding:0.85rem 1rem;font-size:0.85rem;font-family:inherit;outline:none;resize:vertical;min-height:130px;margin-bottom:0.75rem;}
  .contact-textarea::placeholder{color:#555;}
  .contact-btn{width:100%;background:var(--white);color:var(--black);border:none;padding:0.85rem;font-size:0.75rem;letter-spacing:0.15em;text-transform:uppercase;font-weight:700;cursor:pointer;transition:background 0.2s;}
  .contact-btn:hover{background:var(--accent);}
  .contact-msg{font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;margin-top:0.5rem;display:none;}

  /* SIZE GUIDE POPUP */
  .size-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.85);z-index:500;align-items:center;justify-content:center;}
  .size-overlay.active{display:flex;}
  .size-popup{background:#111;border:1px solid var(--border);max-width:600px;width:90%;padding:2.5rem;position:relative;max-height:90vh;overflow-y:auto;}
  .size-popup::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--accent);}
  .size-close{position:absolute;top:1rem;right:1rem;background:none;border:none;color:var(--muted);font-size:1.2rem;cursor:pointer;}
  .size-title{font-size:1.5rem;font-weight:800;text-transform:uppercase;margin-bottom:0.5rem;}
  .size-sub{font-size:0.72rem;color:var(--muted);margin-bottom:1.5rem;line-height:1.6;}
  .size-table{width:100%;border-collapse:collapse;font-size:0.75rem;}
  .size-table th{background:#0a0a0a;color:var(--accent);padding:0.65rem 1rem;text-align:left;font-size:0.6rem;letter-spacing:0.15em;text-transform:uppercase;border-bottom:1px solid var(--border);}
  .size-table td{padding:0.65rem 1rem;color:var(--muted);border-bottom:1px solid #1a1a1a;}
  .size-table tr:hover td{background:#0f0f0f;}
  .size-tab{background:none;border:1px solid var(--border);color:var(--muted);padding:0.4rem 1rem;font-size:0.65rem;letter-spacing:0.12em;text-transform:uppercase;cursor:pointer;margin-right:0.5rem;margin-bottom:1rem;}
  .size-tab.active{background:var(--white);color:var(--black);border-color:var(--white);}

  /* NEWSLETTER POPUP */
  .popup-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.85);z-index:500;align-items:center;justify-content:center;}
  .popup-overlay.active{display:flex;}
  .popup{background:#111;border:1px solid var(--border);max-width:420px;width:90%;padding:2.5rem;position:relative;}
  .popup::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--accent);}
  .popup-close{position:absolute;top:1rem;right:1rem;background:none;border:none;color:var(--muted);font-size:1.2rem;cursor:pointer;}
  .popup-tag{font-size:0.6rem;letter-spacing:0.25em;text-transform:uppercase;color:var(--accent);margin-bottom:1rem;}
  .popup-title{font-size:1.8rem;font-weight:800;text-transform:uppercase;line-height:0.9;margin-bottom:1rem;}
  .popup-sub{font-size:0.8rem;color:var(--muted);line-height:1.7;margin-bottom:1.5rem;}
  .popup-input{width:100%;background:#0a0a0a;border:1px solid var(--border);color:var(--white);padding:0.85rem 1rem;font-size:0.85rem;font-family:inherit;outline:none;margin-bottom:0.75rem;}
  .popup-input::placeholder{color:#555;}
  .popup-btn{width:100%;background:var(--white);color:var(--black);border:none;padding:0.85rem;font-size:0.75rem;letter-spacing:0.15em;text-transform:uppercase;font-weight:700;cursor:pointer;transition:background 0.2s;}
  .popup-btn:hover{background:var(--accent);}
  .popup-msg{font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;margin-top:0.5rem;display:none;}

  nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;justify-content:space-between;align-items:center;padding:1.25rem 2.5rem;border-bottom:1px solid var(--border);background:rgba(10,10,10,0.92);backdrop-filter:blur(8px);}
  .nav-logo{font-size:1.25rem;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;}
  .nav-links{display:flex;gap:1.5rem;font-size:0.72rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--muted);}
  .nav-links span,.nav-links a{cursor:pointer;transition:color 0.2s;}
  .nav-links span:hover,.nav-links a:hover{color:var(--white);}
  .nav-cta{font-size:0.75rem;letter-spacing:0.12em;text-transform:uppercase;border:1px solid var(--accent);color:var(--accent);padding:0.5rem 1.25rem;cursor:pointer;transition:all 0.2s;background:none;}
  .nav-cta:hover{background:var(--accent);color:var(--black);}

  .hero{min-height:100vh;display:flex;flex-direction:column;justify-content:flex-end;padding:0 2.5rem 4rem;position:relative;overflow:hidden;}
  .hero-bg{position:absolute;inset:0;background:linear-gradient(160deg,#0f0f0f 0%,#0a0a0a 60%);z-index:0;}
  .hero-canvas{position:absolute;inset:0;z-index:1;opacity:0.35;}
  .glitch{position:relative;}
  .glitch::before,.glitch::after{content:attr(data-text);position:absolute;top:0;left:0;width:100%;height:100%;}
  .glitch::before{left:2px;text-shadow:-2px 0 #e8d5b0;clip:rect(24px,550px,90px,0);animation:glitch-1 3s infinite linear alternate-reverse;}
  .glitch::after{left:-2px;text-shadow:2px 0 rgba(255,255,255,0.3);clip:rect(85px,550px,140px,0);animation:glitch-2 2.5s infinite linear alternate-reverse;}
  @keyframes glitch-1{0%{clip:rect(20px,9999px,80px,0);transform:skew(0.5deg);}20%{clip:rect(60px,9999px,100px,0);transform:skew(0.3deg);}40%{clip:rect(10px,9999px,50px,0);transform:skew(0.6deg);}60%{clip:rect(90px,9999px,130px,0);transform:skew(0.2deg);}80%{clip:rect(40px,9999px,70px,0);transform:skew(0.4deg);}100%{clip:rect(5px,9999px,30px,0);transform:skew(0.1deg);}}
  @keyframes glitch-2{0%{clip:rect(50px,9999px,120px,0);transform:skew(-0.4deg);}25%{clip:rect(30px,9999px,80px,0);transform:skew(-0.6deg);}50%{clip:rect(70px,9999px,110px,0);transform:skew(-0.2deg);}75%{clip:rect(15px,9999px,60px,0);transform:skew(-0.5deg);}100%{clip:rect(85px,9999px,130px,0);transform:skew(-0.3deg);}}

  /* INSTAGRAM FEED */
  .ig-section{border-top:1px solid var(--border);}
  .ig-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0.75rem;margin-top:2rem;}
  .ig-item{aspect-ratio:1;overflow:hidden;position:relative;cursor:pointer;}
  .ig-item img{width:100%;height:100%;object-fit:cover;transition:transform 0.4s,filter 0.4s;}
  .ig-item:hover img{transform:scale(1.05);filter:brightness(0.7);}
  .ig-overlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;opacity:0;transition:opacity 0.3s;gap:0.5rem;}
  .ig-item:hover .ig-overlay{opacity:1;}
  .ig-likes{font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#fff;font-weight:700;}
  .ig-follow{display:block;margin-top:2rem;text-align:center;font-size:0.7rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--accent);border:1px solid var(--accent);padding:0.65rem 2rem;width:fit-content;}
  .hero-tag{font-size:0.7rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--accent);margin-bottom:1.5rem;position:relative;z-index:2;}
  .hero-title{font-size:clamp(3.5rem,10vw,8rem);font-weight:800;line-height:0.9;text-transform:uppercase;letter-spacing:-0.02em;position:relative;z-index:2;}
  .hero-title span{display:block;}
  .hero-title .outline{-webkit-text-stroke:1px var(--white);color:transparent;}
  .hero-sub{margin-top:2rem;max-width:480px;font-size:0.95rem;color:var(--muted);line-height:1.7;position:relative;z-index:2;}
  .hero-actions{margin-top:2.5rem;display:flex;gap:1rem;position:relative;z-index:2;}
  .btn-primary{background:var(--white);color:var(--black);padding:0.85rem 2rem;font-size:0.78rem;letter-spacing:0.14em;text-transform:uppercase;font-weight:700;cursor:pointer;border:none;transition:all 0.2s;}
  .btn-primary:hover{background:var(--accent);}
  .btn-outline{background:transparent;color:var(--white);padding:0.85rem 2rem;font-size:0.78rem;letter-spacing:0.14em;text-transform:uppercase;font-weight:700;cursor:pointer;border:1px solid var(--border);transition:all 0.2s;}
  .btn-outline:hover{border-color:var(--white);}

  .marquee-wrap{border-top:1px solid var(--border);border-bottom:1px solid var(--border);overflow:hidden;padding:0.85rem 0;background:#111;}
  .marquee-track{display:flex;gap:3rem;white-space:nowrap;animation:marquee 20s linear infinite;}
  .marquee-track span{font-size:0.7rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--muted);}
  .marquee-track .dot{color:var(--accent);}
  @keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}

  section{padding:6rem 2.5rem;}
  .section-label{font-size:0.65rem;letter-spacing:0.22em;text-transform:uppercase;color:var(--accent);margin-bottom:1.5rem;}
  .section-title{font-size:clamp(2rem,5vw,3.5rem);font-weight:800;text-transform:uppercase;line-height:1;letter-spacing:-0.01em;}

  .mission{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center;border-top:1px solid var(--border);}
  .mission-right{color:var(--muted);font-size:1.05rem;line-height:1.85;}
  .mission-right strong{color:var(--white);font-weight:500;}
  .mission-pill{display:inline-block;margin-top:2rem;background:var(--card-bg);border:1px solid var(--border);padding:0.5rem 1.25rem;font-size:0.7rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--accent);}

  .shop-header{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:2rem;border-top:1px solid var(--border);padding-top:3rem;}
  .shop-actions{display:flex;gap:1rem;align-items:center;}

  /* SCHOLARSHIP TRACKER */
  .tracker{background:var(--card-bg);border:1px solid var(--border);padding:2rem;margin-bottom:3rem;}
  .tracker-label{font-size:0.6rem;letter-spacing:0.22em;text-transform:uppercase;color:var(--accent);margin-bottom:1rem;}
  .tracker-title{font-size:1rem;font-weight:700;color:var(--white);margin-bottom:1.25rem;}
  .tracker-bar-wrap{background:#0a0a0a;height:6px;width:100%;margin-bottom:0.75rem;}
  .tracker-bar{height:6px;background:var(--accent);width:0%;transition:width 1.5s ease;}
  .tracker-stats{display:flex;justify-content:space-between;font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;}
  .tracker-raised{color:var(--accent);font-weight:700;}
  .tracker-goal{color:var(--muted);}

  /* SHIPPING */
  .shipping{background:#0f0f0f;border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
  .shipping-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);margin-top:3rem;}
  .shipping-item{background:var(--black);padding:2rem 1.75rem;}
  .shipping-icon{font-size:1.5rem;margin-bottom:0.75rem;}
  .shipping-title{font-size:0.75rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--white);margin-bottom:0.5rem;}
  .shipping-desc{font-size:0.72rem;color:var(--muted);line-height:1.7;}

  .impact{background:#0f0f0f;border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
  .impact-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);margin-top:3rem;}
  .impact-item{background:var(--black);padding:2.5rem 2rem;}
  .impact-num{font-size:3.5rem;font-weight:800;line-height:1;color:var(--accent);}
  .impact-label{font-size:0.7rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--muted);margin-top:0.5rem;}

  .stories-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;margin-top:3rem;}
  .story-card{background:var(--card-bg);border:1px solid var(--border);padding:1.75rem;}
  .story-quote{font-size:0.85rem;color:var(--muted);line-height:1.8;margin-bottom:1.25rem;font-style:italic;}
  .story-author{font-size:0.65rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--accent);}
  .story-form{margin-top:3rem;background:var(--card-bg);border:1px solid var(--border);padding:2rem;}
  .story-form-title{font-size:0.7rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--accent);margin-bottom:1.5rem;}
  .story-fields{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;}
  .field input,.field select,.field textarea{width:100%;background:#111;border:1px solid var(--border);color:var(--white);padding:0.85rem 1rem;font-size:0.85rem;font-family:inherit;outline:none;}
  .field input::placeholder,.field textarea::placeholder{color:#555;}
  .field textarea{resize:vertical;min-height:100px;}

  .scholarship{border-top:1px solid var(--border);}
  .scholarship-inner{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:start;}
  .scholarship-form{background:var(--card-bg);border:1px solid var(--border);padding:2rem;}
  .schol-fields{display:flex;flex-direction:column;gap:1rem;}

  .faq{background:#0f0f0f;border-top:1px solid var(--border);}
  .faq-list{margin-top:3rem;display:flex;flex-direction:column;gap:1px;background:var(--border);}
  .faq-item{background:var(--black);overflow:hidden;}
  .faq-q{padding:1.25rem 1.75rem;display:flex;justify-content:space-between;align-items:center;cursor:pointer;font-size:0.85rem;font-weight:600;letter-spacing:0.05em;}
  .faq-q:hover{background:#111;}
  .faq-icon{color:var(--accent);font-size:1.2rem;flex-shrink:0;transition:transform 0.3s;}
  .faq-icon.open{transform:rotate(45deg);}
  .faq-a{max-height:0;overflow:hidden;transition:max-height 0.3s ease;}
  .faq-a.open{max-height:200px;}
  .faq-a-inner{padding:0 1.75rem 1.25rem;font-size:0.82rem;color:var(--muted);line-height:1.8;}

  .volunteer{border-top:1px solid var(--border);}
  .volunteer-inner{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:start;}
  .volunteer-cards{display:flex;flex-direction:column;gap:1rem;margin-top:2rem;}
  .vol-card{background:var(--card-bg);border:1px solid var(--border);padding:1.5rem;display:flex;gap:1.25rem;align-items:flex-start;}
  .vol-icon{width:36px;height:36px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:1rem;flex-shrink:0;}
  .vol-title{font-size:0.8rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:0.4rem;}
  .vol-desc{font-size:0.75rem;color:var(--muted);line-height:1.5;}

  .form-wrap{display:flex;flex-direction:column;gap:1rem;}
  .form-row{display:grid;grid-template-columns:1fr 1fr;gap:1rem;}
  .field select{appearance:none;cursor:pointer;}
  .form-submit{background:var(--white);color:var(--black);padding:0.9rem 2rem;font-size:0.78rem;letter-spacing:0.14em;text-transform:uppercase;font-weight:700;cursor:pointer;border:none;width:100%;transition:background 0.2s;}
  .form-submit:hover{background:var(--accent);}

  /* PRESS */
  .press{border-top:1px solid var(--border);}
  .press-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:2rem;}
  .press-card{background:var(--card-bg);border:1px solid var(--border);padding:1.5rem;}
  .press-source{font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--accent);margin-bottom:0.5rem;}
  .press-quote{font-size:0.78rem;color:var(--muted);line-height:1.7;font-style:italic;}

  footer{border-top:1px solid var(--border);padding:3rem 2.5rem;display:flex;justify-content:space-between;align-items:center;}
  .footer-logo{font-size:1rem;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;}
  .footer-tagline{font-size:0.7rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--muted);}
  .footer-links{display:flex;gap:2rem;font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--muted);}
  .footer-links span{cursor:pointer;}
  .footer-links span:hover,.footer-links a:hover{color:var(--white);}

  @media(max-width:768px){
    nav{padding:1rem 1.25rem;}
    .nav-links{display:none;}
    .hero{padding:0 1.25rem 3rem;}
    section{padding:4rem 1.25rem;}
    .mission,.volunteer-inner,.scholarship-inner{grid-template-columns:1fr;gap:2.5rem;}
    .impact-grid,.shipping-grid{grid-template-columns:1fr;}
    .stories-grid,.press-grid{grid-template-columns:1fr;}
    .story-fields,.form-row{grid-template-columns:1fr;}
    footer{flex-direction:column;gap:1.5rem;text-align:center;}
    .footer-links{flex-wrap:wrap;justify-content:center;}
    .cookie-banner{flex-direction:column;align-items:flex-start;}
  }
  @media(max-width:480px){.hero-actions{flex-direction:column;}}
</style>
{{ content_for_header }}</head>
<body>

<!-- COOKIE BANNER -->
<div class="cookie-banner" id="cookie-banner">
  <div class="cookie-text">We use cookies to improve your experience on our site. By continuing to browse, you agree to our use of cookies. <a href="#">Learn more</a></div>
  <div class="cookie-btns">
    <button class="cookie-accept" onclick="acceptCookies()">Accept</button>
    <button class="cookie-decline" onclick="declineCookies()">Decline</button>
  </div>
</div>

