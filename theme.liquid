        </div>
        <div class="field"><textarea id="sc-story" placeholder="Tell us your story and why you're applying..." style="width:100%;background:#111;border:1px solid var(--border);color:var(--white);padding:0.85rem 1rem;font-size:0.85rem;font-family:inherit;outline:none;resize:vertical;min-height:120px;"></textarea></div>
        <button class="form-submit" onclick="submitScholarship()">Submit Application →</button>
