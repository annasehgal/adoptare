    <span onclick="scroll2('volunteer')">Volunteer</span>
    <a href="https://www.instagram.com/adoptare_est2026" target="_blank">Instagram</a>
    <span onclick="document.getElementById('contact-popup').classList.add('active')">Contact</span>
  </div>
</footer>

<script>
  function scroll2(id){document.getElementById(id).scrollIntoView({behavior:'smooth'});}

  // Film grain noise
  (function(){
    const c=document.getElementById('noise-canvas');
    const ctx=c.getContext('2d');
    function resize(){c.width=c.offsetWidth;c.height=c.offsetHeight;}
    resize();window.addEventListener('resize',resize);
    function grain(){
      const w=c.width,h=c.height;
      const img=ctx.createImageData(w,h);
      const d=img.data;
      for(let i=0;i<d.length;i+=4){
        const v=Math.random()*255|0;
        d[i]=d[i+1]=d[i+2]=v;d[i+3]=255;
      }
      ctx.putImageData(img,0,0);
      requestAnimationFrame(grain);
    }
    grain();
  })();

  // Back to top
  const backBtn=document.getElementById('back-to-top');
  window.addEventListener('scroll',()=>{backBtn.classList.toggle('visible',window.scrollY>400);});

  // Cookie banner
  if(localStorage.getItem('adoptare_cookies')){document.getElementById('cookie-banner').classList.add('hidden');}
  function acceptCookies(){localStorage.setItem('adoptare_cookies','accepted');document.getElementById('cookie-banner').classList.add('hidden');}
  function declineCookies(){localStorage.setItem('adoptare_cookies','declined');document.getElementById('cookie-banner').classList.add('hidden');}

  // Newsletter popup
  setTimeout(()=>{if(!localStorage.getItem('adoptare_popup')){document.getElementById('newsletter-popup').classList.add('active');}},10000);
  function closePopup(){document.getElementById('newsletter-popup').classList.remove('active');localStorage.setItem('adoptare_popup','true');}

  // Scholarship tracker — update the raised amount here when you have real data
  var raised=546, goal=1000;
  document.getElementById('tracker-raised').textContent='$'+raised.toLocaleString()+' raised';
  setTimeout(()=>{document.getElementById('tracker-bar').style.width=(raised/goal*100)+'%';},500);

  // Size guide tabs
  function showSizeTab(tab,btn){
    ['unisex','womens','polo','cap'].forEach(t=>document.getElementById('tab-'+t).style.display='none');
    document.querySelectorAll('.size-tab').forEach(b=>b.classList.remove('active'));
    document.getElementById('tab-'+tab).style.display='block';
    btn.classList.add('active');
  }

  // Counter animation
  const counters=document.querySelectorAll('.counter');
  const obs=new IntersectionObserver(entries=>{
    entries.forEach(e=>{
      if(e.isIntersecting){
        const el=e.target,target=+el.dataset.target,suffix=el.dataset.suffix||'';
        let cur=0;const step=target/60;
        const t=setInterval(()=>{cur=Math.min(cur+step,target);el.textContent=Math.floor(cur)+suffix;if(cur>=target)clearInterval(t);},25);
        obs.unobserve(el);
      }
    });
  },{threshold:0.5});
  counters.forEach(c=>obs.observe(c));

  // FAQ
  function toggleFaq(i){
    const a=document.getElementById('fa'+i),icon=document.getElementById('fi'+i),isOpen=a.classList.contains('open');
    document.querySelectorAll('.faq-a').forEach(el=>el.classList.remove('open'));
    document.querySelectorAll('.faq-icon').forEach(el=>el.classList.remove('open'));
    if(!isOpen){a.classList.add('open');icon.classList.add('open');}
  }

  // Forms
  async function post(data){return fetch('https://formspree.io/f/meepbjwb',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(data)});}

  async function submitForm(){
    const btn=document.getElementById('submit-btn'),msg=document.getElementById('form-msg');
    const data={fname:document.getElementById('fname').value,lname:document.getElementById('lname').value,email:document.getElementById('email').value,help:document.getElementById('help').value,message:document.getElementById('message').value,type:'Volunteer Signup'};
    if(!data.fname||!data.email){msg.style.display='block';msg.style.color='#e87070';msg.textContent='Please fill in your name and email.';return;}
    btn.textContent='Sending...';btn.disabled=true;
    try{const r=await post(data);if(r.ok){msg.style.display='block';msg.style.color='var(--accent)';msg.textContent="You're in. Thanks for joining the movement.";}else throw 0;}
    catch{msg.style.display='block';msg.style.color='#e87070';msg.textContent='Something went wrong. Please try again.';}
    btn.textContent='Submit →';btn.disabled=false;
  }

  async function submitStory(){
    const msg=document.getElementById('story-msg');
    const data={name:document.getElementById('sname').value,location:document.getElementById('slocation').value,story:document.getElementById('sstory').value,type:'Story Submission'};
    if(!data.story){msg.style.display='block';msg.style.color='#e87070';msg.textContent='Please write your story.';return;}
    try{await post(data);msg.style.display='block';msg.style.color='var(--accent)';msg.textContent='Thank you for sharing your story.';}
    catch{msg.style.display='block';msg.style.color='#e87070';msg.textContent='Something went wrong. Try again.';}
  }

  async function submitScholarship(){
    const msg=document.getElementById('sc-msg');
    const data={fname:document.getElementById('sc-fname').value,lname:document.getElementById('sc-lname').value,email:document.getElementById('sc-email').value,school:document.getElementById('sc-school').value,identity:document.getElementById('sc-type').value,story:document.getElementById('sc-story').value,type:'Scholarship Application'};
    if(!data.fname||!data.email||!data.story){msg.style.display='block';msg.style.color='#e87070';msg.textContent='Please fill in all required fields.';return;}
    try{await post(data);msg.style.display='block';msg.style.color='var(--accent)';msg.textContent='Application received. We will be in touch soon.';}
    catch{msg.style.display='block';msg.style.color='#e87070';msg.textContent='Something went wrong. Try again.';}
  }

  async function submitContact(){
    const msg=document.getElementById('contact-msg');
    const data={name:document.getElementById('c-name').value,email:document.getElementById('c-email').value,subject:document.getElementById('c-subject').value,message:document.getElementById('c-message').value,type:'Contact Form'};
    if(!data.name||!data.email||!data.message){msg.style.display='block';msg.style.color='#e87070';msg.textContent='Please fill in all required fields.';return;}
    try{await post(data);msg.style.display='block';msg.style.color='var(--accent)';msg.textContent='Message sent. We will be in touch soon.';setTimeout(()=>document.getElementById('contact-popup').classList.remove('active'),2500);}
    catch{msg.style.display='block';msg.style.color='#e87070';msg.textContent='Something went wrong. Try again.';}
  }

  async function submitPopup(){
    const email=document.getElementById('popup-email').value,msg=document.getElementById('popup-msg');
    if(!email){msg.style.display='block';msg.style.color='#e87070';msg.textContent='Please enter your email.';return;}
    try{await post({email,type:'Newsletter Signup'});msg.style.display='block';msg.style.color='var(--accent)';msg.textContent="You're in. Welcome to the movement.";localStorage.setItem('adoptare_popup','true');setTimeout(closePopup,2000);}
    catch{msg.style.display='block';msg.style.color='#e87070';msg.textContent='Something went wrong. Try again.';}
  }
</script>
{{ content_for_layout }}</body>
</html>