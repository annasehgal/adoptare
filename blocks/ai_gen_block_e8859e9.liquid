      "label": "Grid opacity",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "%",
      "default": 5
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 0
