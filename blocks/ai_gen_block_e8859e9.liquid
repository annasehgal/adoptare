      "default": "Discover our curated collection of timeless pieces designed for the modern minimalist."
    },
    {
      "type": "text",
      "id": "primary_btn_text",
      "label": "Primary button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "primary_btn_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_btn_text",
      "label": "Secondary button text",
      "default": "Explore collection"
    },
    {
      "type": "header",
      "content": "Overlay panel"
    },
    {
      "type": "text",
      "id": "overlay_tag",
      "label": "Tag line",
      "default": "New arrivals"
    },
    {
      "type": "text",
      "id": "overlay_title_line1",
      "label": "Title line 1",
      "default": "Curated"
    },
    {
      "type": "text",
      "id": "overlay_title_line2",
